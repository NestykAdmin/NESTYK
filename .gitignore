# ==========================================
# NESTIQ (NESTYK) — Comprehensive .gitignore
# ==========================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js
.pnpm-store
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# --- Monorepo & Build Tools ---
.turbo/
.cache/
.parcel-cache/
dist/
build/
out/
Release/

# --- Next.js (Web, Owner, Agent, Admin) ---
.next/
!.next/cache/
.next/cache/

# --- Expo & Mobile Native (iOS / Android) ---
.expo/
.expo-shared/
web-build/

# Native builds & Pods (if prebuilt/ejected)
android/app/build/
android/.gradle/
android/local.properties
ios/Pods/
ios/build/
ios/*.xcworkspace/xcuserdata/
ios/*.xcodeproj/xcuserdata/

# Mobile Signing Credentials & Keystores (Security)
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.orig.*

# --- Backend & Database (NestJS / Supabase / TypeORM) ---
apps/api/dist/
*.seed
*.pid
*.pid.lock

# --- Environment & Secret Variables ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.api.example

# GCP / Vertex AI service-account private keys (never commit)
secrets/
**/gcp-*-sa.json
nestyk-*-*.json
nestiq-*-*.json
*-service-account*.json

# --- Logs & Runtime Reports ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Testing & Code Coverage ---
coverage/
*.lcov
.nyc_output/

# --- TypeScript Build Cache ---
*.tsbuildinfo

# --- Editor & IDE Directories ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Local uploaded room images
.data/

# temp files left by Claude sessions (keep out of git)
_to_delete_*/
Claude outputs/
