# =====================================================================
# NESTYK เว็บ · landlord.nestyk.com (เตรียมไว้ ยังไม่เปิด)
# ค่า env ของ Vercel project "nestyk-web-landlord" (Production)
# วิธีใช้: Vercel → project → Settings → Environment Variables → Import .env แล้ววางทั้งไฟล์
#   จากนั้นแทนทุกค่าที่เป็น <...> · ค่าทั้งหมดถูกฝังในเว็บ ใครก็เปิดดูได้ ห้ามใส่คีย์ลับ (service_role, รหัส DB)
#   EXPO_PUBLIC_BUILD_SHA ไม่ใส่ที่นี่ ใส่ใน Build Command (ดู README.md)
#   แก้ค่าแล้วต้อง Redeploy เพราะ Expo ฝังค่าตอน build
# =====================================================================

# 1) API · ชุด production ใหม่บน Railway (ไม่ใช่ nestyk-dev) · มี /api/v1 ท้าย ห้ามมี / ปิดท้าย
EXPO_PUBLIC_API_URL=https://<prod-api-domain>/api/v1

# 2) Supabase production · คีย์สาธารณะ anon เท่านั้น
EXPO_PUBLIC_SUPABASE_URL=https://<prod-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<prod-anon-key>

# 3) โหมดแอป · production = ไม่โชว์ป้าย env ท้ายหน้า · ปิดล็อกอินปลอมและการขอบทบาทแบบ dev
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_USE_DEV_AUTH=false
EXPO_PUBLIC_ALLOW_DEV_ROLE_GRANT=false
# URL หน้าสาธารณะ (ลิงก์แชร์) · ทุกโดเมนชี้ไปเว็บ guest
EXPO_PUBLIC_BASE_URL=https://nestyk.com

# 4) คีย์สาธารณะ
# hCaptcha: ต้องเพิ่ม landlord.nestyk.com ในรายชื่อโดเมนของไซต์ใน hCaptcha Dashboard
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=<hcaptcha-site-key>
# Google Maps (แผนที่ปักหมุด): ใช้คีย์ฝั่งเว็บที่จำกัด HTTP referrer เป็น https://landlord.nestyk.com/*
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=<web-maps-key>

# 5) Portal · เว็บนี้เปิดเฉพาะบทบาท landlord (path /landlord) · บทบาทอื่นของบัญชีเปิดที่เว็บ guest
EXPO_PUBLIC_WEB_PORTAL=landlord
EXPO_PUBLIC_WEB_PORTAL_URLS=all=https://nestyk.com
# ออกจากระบบแล้วไปหน้าเข้าสู่ระบบ (เป็นค่าเริ่มต้นของ portal บทบาทอยู่แล้ว ใส่ไว้ให้เห็นชัด)
EXPO_PUBLIC_WEB_SIGN_OUT_TO=login

# 6) เปิด/ปิดฟีเจอร์ · production ปิดทั้งคู่
EXPO_PUBLIC_ENABLE_SOCIAL_LOGIN=false
EXPO_PUBLIC_ENABLE_ACCOUNT_DELETION=false
