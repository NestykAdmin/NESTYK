# =====================================================================
# NESTYK เว็บ · nestyk.com (เว็บ guest, apps/web Next.js)
# ค่า env ของ Vercel project "nestyk-guest" (Production) · project นี้ถือโดเมน nestyk.com
# วิธีใช้: Vercel → project → Settings → Environment Variables → Import .env แล้ววางทั้งไฟล์ แทนทุกค่า <...>
#   NEXT_PUBLIC_* ถูกฝังในเว็บ ใครก็เปิดดูได้ ห้ามใส่คีย์ลับ · แก้ค่าแล้วต้อง Redeploy
#   Root Directory: apps/web · Framework: Next.js
# =====================================================================

# 1) API (ฝั่ง server ของ Next) · ไม่มี /api/v1 ท้าย: /api/... ถูกส่งต่อเป็น <API_URL>/api/v1/...
API_URL=https://<prod-api-domain>
# หน้าแชร์ห้อง /s/<token> ใช้ตัวนี้ (มี /api/v1 ท้าย)
NEXT_PUBLIC_API_URL=https://<prod-api-domain>/api/v1

# 2) หน้าบัญชีบนโดเมนเดียวกัน (ฝั่ง server) · URL ของ Vercel project "nestyk-web" (consumer-app) ไม่มี / ปิดท้าย
#   /login, /register, /reset-password, /no-access, /privacy, /terms, /agent…, /_expo/…, /assets/… ถูกส่งต่อไปที่นี่
#   project นั้นต้องมี SPA rewrite (README.md) · ไม่ตั้ง = ไม่ส่งต่อ (ลิงก์ไป NEXT_PUBLIC_ACCOUNT_WEB_ORIGIN แบบเดิม)
ACCOUNT_WEB_UPSTREAM=https://<nestyk-web-project>.vercel.app
# NEXT_PUBLIC_ACCOUNT_WEB_ORIGIN ไม่ต้องตั้ง (ลิงก์บัญชีอยู่บน nestyk.com เมื่อตั้ง ACCOUNT_WEB_UPSTREAM)

# 3) SEO · ที่อยู่ของเว็บนี้ (canonical, hreflang, sitemap) และเปิดให้ Google เก็บ (production เท่านั้น)
NEXT_PUBLIC_SITE_ORIGIN=https://nestyk.com
NEXT_PUBLIC_SITE_INDEXABLE=true

# 4) Google Maps ฝั่งเว็บ · คีย์ที่จำกัด HTTP referrer เป็น https://nestyk.com/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<web-maps-key>
