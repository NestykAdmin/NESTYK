{
  "name": "nestyk-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "NESTYK — Multi-App PropTech Monorepo Ecosystem",
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@nestyk/web --filter=@nestyk/api --filter=@nestyk/consumer-app",
    "dev:all": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "check:roles": "node apps/api/scripts/check-roles.cjs",
    "clean": "turbo clean && rm -rf node_modules",
    "postinstall": "npx --yes patch-package"
  },
  "devDependencies": {
    "patch-package": "^8.0.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
