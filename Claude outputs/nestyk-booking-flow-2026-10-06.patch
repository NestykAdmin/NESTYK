+    return load([`${base}.ts`, `${base}.tsx`].find(candidate => fs.existsSync(candidate)), mocks);
+  };
+  new Function('require', 'module', 'exports', js)(localRequire, loaded, loaded.exports);
+  return loaded.exports;
+};
