{
  "name": "@nestyk/ui",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./native": {
      "types": "./src/native.ts",
      "default": "./src/native.ts"
    },
    "./web-content": {
      "types": "./src/shells/WebContentContainer.tsx",
      "react-native": "./src/shells/WebContentContainer.native.tsx",
      "default": "./src/shells/WebContentContainer.tsx"
    },
    "./assets/logo/*": "./assets/logo/*",
    "./assets/logo/IconApp/*": "./assets/logo/IconApp/*",
    "./assets/nestyk/svg/*": "./assets/nestyk/svg/*",
    "./assets/nestyk/png/*": "./assets/nestyk/png/*",
    "./assets/nestyk/hatch/*": "./assets/nestyk/hatch/*"
  },
  "scripts": {
    "build": "tsc",
    "lint": "echo 'No lint specified'"
  },
  "dependencies": {
    "@nestyk/config": "*",
    "@nestyk/i18n": "*",
    "@nestyk/types": "*",
    "phosphor-react": "^1.4.1",
    "phosphor-react-native": "^2.3.1",
    "react-native-zoom-toolkit": "^5.1.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-native": "*",
    "react-native-gesture-handler": ">=2.0.0",
    "react-native-reanimated": ">=3.0.0",
    "react-native-svg": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "19.1.0",
    "typescript": "~5.9.2"
  }
}
