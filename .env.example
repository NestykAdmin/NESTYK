# =====================================================================
# NESTYK — Frontend (.env ที่ root)
# ไฟล์ตัวอย่าง (commit ได้): cp .env.example .env แล้วใส่ค่าที่ว่างหรือมี <...> ห้ามใส่ค่าจริงในไฟล์นี้
# ใช้โดย: apps/consumer-app (Expo) และ apps/web (Next.js)
# - ค่า EXPO_PUBLIC_* / NEXT_PUBLIC_* ถูกฝังลงในแอปและเว็บ ใครก็เปิดดูได้ ห้ามใส่คีย์ลับ (service_role, รหัส DB)
# - แก้แล้วต้องเริ่มใหม่: Expo ใช้ `npx expo start -c`, เว็บ restart `npm run dev`
# - ห้าม commit ไฟล์นี้
# =====================================================================

# ---------------------------------------------------------------------
# 1) API ที่แอปและเว็บเรียก — เปิดไว้ชุดเดียว (A หรือ B)
# ---------------------------------------------------------------------
# [A] API บน Railway (dev) ← ใช้อยู่
API_URL=https://nestyk-dev.up.railway.app
NEXT_PUBLIC_API_URL=https://nestyk-dev.up.railway.app/api/v1
EXPO_PUBLIC_API_URL=https://nestyk-dev.up.railway.app/api/v1

# [B] API บนเครื่อง Mac (`npm run dev`) — จะใช้ให้ใส่ # หน้า 3 บรรทัดของ [A] แล้วเอา # ออกจาก 3 บรรทัดนี้
# API_URL=http://localhost:4000
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
#
# API_URL ไม่มี /api/v1 (apps/web/next.config.js เติมให้เอง) ส่วนอีก 2 ตัวต้องมี และห้ามมี / ปิดท้าย

# ---------------------------------------------------------------------
# 2) Supabase — ใช้ล็อกอินเท่านั้น (คีย์สาธารณะ anon)
# ---------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# 3) ล็อกอินปลอม (dev token) — ปิดไว้ เพราะ API บน Railway ไม่รับ
# ---------------------------------------------------------------------
# ล็อกอินปลอมเปิดเมื่อ USE_DEV_AUTH=true "หรือ" APP_ENV=development (apps/consumer-app/lib/auth/dev-auth.ts)
# จะเปิดได้เฉพาะตอนใช้ API บนเครื่องที่ตั้ง ALLOW_DEV_AUTH=true ใน .env.api
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_USE_DEV_AUTH=false
EXPO_PUBLIC_ALLOW_DEV_ROLE_GRANT=false
# บัญชีปลอม: ค่าเริ่มต้นอยู่ใน dev-auth.ts ถ้าจะเปลี่ยนให้เพิ่ม EXPO_PUBLIC_DEV_LOGIN_EMAIL / _PASSWORD / _UUID / _FIRST_NAME / _LAST_NAME

# ---------------------------------------------------------------------
# 4) ค่าทั่วไปของแอป
# ---------------------------------------------------------------------
# บทบาทตอนเปิดแอปครั้งแรก: guest | tenant | owner | agent | admin
EXPO_PUBLIC_DEFAULT_ROLE=agent
# URL ของเว็บ (ลิงก์แชร์ / หน้า portal) — เปลี่ยนเป็นโดเมน Vercel เมื่อเว็บขึ้นแล้ว
EXPO_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# 5) Google Maps ในแอป
# ---------------------------------------------------------------------
# ⚠ ยังไม่ได้ใส่ — แผนที่ในแอป (app.config.js) จะไม่มีคีย์
# ใส่คีย์ที่เปิด "Maps SDK for Android" ไว้ (ลองใช้ค่า GOOGLE_MAPS_API_KEY ใน .env.api ได้ ถ้าคีย์นั้นเปิด Maps SDK แล้ว)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
