# =====================================================================
# NESTYK — Frontend (.env ที่ root)
# ไฟล์ตัวอย่าง (commit ได้): cp .env.example .env แล้วใส่ค่าที่ว่างหรือมี <...> ห้ามใส่ค่าจริงในไฟล์นี้
# ใช้โดย: apps/consumer-app (Expo) และ apps/web (Next.js)
# - ค่า EXPO_PUBLIC_* / NEXT_PUBLIC_* ถูกฝังลงในแอปและเว็บ ใครก็เปิดดูได้ ห้ามใส่คีย์ลับ (service_role, รหัส DB)
# - แก้แล้วต้องเริ่มใหม่: Expo ใช้ `npx expo start -c`, เว็บ restart `npm run dev`
# - ห้าม commit ไฟล์นี้
# =====================================================================

# ---------------------------------------------------------------------
# 1) API ที่แอปและเว็บเรียก — เปิดไว้ชุดเดียว (A หรือ B)
# ---------------------------------------------------------------------
# [A] API บน Railway (dev) ← ใช้อยู่
API_URL=https://nestyk-dev.up.railway.app
NEXT_PUBLIC_API_URL=https://nestyk-dev.up.railway.app/api/v1
EXPO_PUBLIC_API_URL=https://nestyk-dev.up.railway.app/api/v1

# [B] API บนเครื่อง Mac (`npm run dev`) — จะใช้ให้ใส่ # หน้า 3 บรรทัดของ [A] แล้วเอา # ออกจาก 3 บรรทัดนี้
# API_URL=http://localhost:4000
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
#
# API_URL ไม่มี /api/v1 (apps/web/next.config.js เติมให้เอง) ส่วนอีก 2 ตัวต้องมี และห้ามมี / ปิดท้าย

# ---------------------------------------------------------------------
# 2) Supabase — ใช้ล็อกอินเท่านั้น (คีย์สาธารณะ anon)
# ---------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# 3) ล็อกอินปลอม (dev token) — ปิดไว้ เพราะ API บน Railway ไม่รับ
# ---------------------------------------------------------------------
# ล็อกอินปลอมเปิดเมื่อ USE_DEV_AUTH=true "หรือ" APP_ENV=development (apps/consumer-app/lib/auth/dev-auth.ts)
# จะเปิดได้เฉพาะตอนใช้ API บนเครื่องที่ตั้ง ALLOW_DEV_AUTH=true ใน .env.api
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_USE_DEV_AUTH=false
# EXPO_PUBLIC_ALLOW_DEV_ROLE_GRANT=true ให้แอป (โหมด dev เท่านั้น) ขอบทบาท admin/agent ให้บัญชีที่ยังไม่มี ผ่าน /auth/dev/roles
# ใช้คู่กับ API บนเครื่องที่ตั้ง NODE_ENV=development และ ALLOW_DEV_ROLE_GRANT=true ไม่ตั้ง = ไม่ขอ (คนที่สมัครเองได้ agent จาก API อยู่แล้ว)
EXPO_PUBLIC_ALLOW_DEV_ROLE_GRANT=false
# บัญชีปลอม: ค่าเริ่มต้นอยู่ใน dev-auth.ts ถ้าจะเปลี่ยนให้เพิ่ม EXPO_PUBLIC_DEV_LOGIN_EMAIL / _PASSWORD / _UUID / _FIRST_NAME / _LAST_NAME

# ---------------------------------------------------------------------
# 4) ค่าทั่วไปของแอป
# ---------------------------------------------------------------------
# บทบาทตอนเปิดแอปครั้งแรก (มือถือเท่านั้น เว็บเปิดตาม URL): guest | tenant | landlord | agent | admin
# owner เป็นชื่อเก่า แอปเปลี่ยนเป็น landlord ให้เอง
EXPO_PUBLIC_DEFAULT_ROLE=agent
# URL ของเว็บ (ลิงก์แชร์ / หน้า portal) — เปลี่ยนเป็นโดเมน Vercel เมื่อเว็บขึ้นแล้ว
EXPO_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# 5) Google Maps ในแอป
# ---------------------------------------------------------------------
# ⚠ ยังไม่ได้ใส่ — แผนที่ในแอป (app.config.js) จะไม่มีคีย์
# ใส่คีย์ที่เปิด "Maps SDK for Android" ไว้ (ลองใช้ค่า GOOGLE_MAPS_API_KEY ใน .env.api ได้ ถ้าคีย์นั้นเปิด Maps SDK แล้ว)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# แผนที่หน้าแชร์บนเว็บไซต์ (Next.js); ถ้าไม่ระบุจะใช้ EXPO_PUBLIC_GOOGLE_MAPS_API_KEY
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------
# 6) Cloudflare Turnstile — กันบอตตอนสมัคร เข้าสู่ระบบ และลืมรหัสผ่าน (เปลี่ยนจาก hCaptcha 12 พ.ย. 2026)
# Site Key เป็นคีย์สาธารณะ จาก Cloudflare → Turnstile → widget "NESTYK Auth"
# Secret Key ห้ามใส่ในไฟล์นี้ ใส่ที่ Supabase → Authentication → Attack Protection เลือก provider เป็น Turnstile
# ถ้าเว้นว่าง แอปยังไม่โชว์ช่องยืนยัน (ถ้า Supabase เปิด captcha อยู่ จะ login ไม่ได้)
# เครื่อง dev / Supabase Dev ใช้ key ทดสอบของ Cloudflare: site key 1x00000000000000000000AA คู่กับ secret ทดสอบ
#   ห้ามใช้ key ทดสอบกับ production
# ---------------------------------------------------------------------
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------
# 7) เว็บ consumer-app (footer + เปิดเว็บบนเครื่อง)
# EXPO_PUBLIC_BUILD_SHA: เลข commit ที่โชว์ในป้าย env ท้ายหน้า (ไม่โชว์บน production)
#   ใส่ใน build command เช่นบน Vercel: EXPO_PUBLIC_BUILD_SHA=$VERCEL_GIT_COMMIT_SHA npx expo export -p web
#   (ช่อง Environment Variables ของ Vercel ไม่แปลง $VAR ให้) · บนเครื่องเว้นว่างได้ ป้ายจะขึ้น "local"
# EXPO_PUBLIC_WEB_API_PROXY: ตอน dev บนเว็บ ถ้า API อยู่บนเครื่อง (localhost) แอปจะเรียกผ่าน /api ของ :8081
#   ให้ Metro ส่งต่อ (ใช้กับเบราว์เซอร์ใน Claude ได้) ใส่ false เพื่อปิด · ไม่มีผลกับมือถือ build จริง และ API staging
# ---------------------------------------------------------------------
# EXPO_PUBLIC_BUILD_SHA=
# EXPO_PUBLIC_WEB_API_PROXY=true

# ---------------------------------------------------------------------
# 8) เว็บแยกตามบทบาท (portal) และหน้าหลังออกจากระบบ — มีผลกับเว็บเท่านั้น มือถือไม่อ่าน
# EXPO_PUBLIC_WEB_PORTAL: เว็บนี้เปิดบทบาทไหน · all | agent | tenant | landlord | admin
#   all = dev, QA, localhost, app.<domain> (ทุกบทบาท) · agent = agent.nestyk.com (หน้า guest + agent)
#   ค่าว่างหรือสะกดผิด = all
# EXPO_PUBLIC_WEB_PORTAL_URLS: เว็บของ portal อื่น ให้ตัวสลับบทบาทเปิดบทบาทที่เว็บนี้ไม่มี
#   รูปแบบ ชื่อ=https://โดเมน คั่นด้วย , เช่น all=https://app.nestyk.com,tenant=https://tenant.nestyk.com
#   เว้นว่าง = ไม่เสนอบทบาทของ portal อื่น · ชื่อที่ไม่รู้จักหรือ URL ผิดจะถูกข้าม
# EXPO_PUBLIC_WEB_SIGN_OUT_TO: กดออกจากระบบแล้วไปหน้าไหน · guest = หน้าแรก "/" · login = หน้าเข้าสู่ระบบ "/login"
#   เว้นว่าง = ตาม portal: all ไปหน้า guest · portal บทบาท (เช่น agent) ไปหน้าเข้าสู่ระบบ
#   ใช้กับปุ่มออกจากระบบ, ออกจากระบบทุกอุปกรณ์ และแท็บอื่นที่เปิดค้าง · มือถือไปหน้าเข้าสู่ระบบเสมอ
# ---------------------------------------------------------------------
EXPO_PUBLIC_WEB_PORTAL=agent
# EXPO_PUBLIC_WEB_PORTAL_URLS=agent
# EXPO_PUBLIC_WEB_SIGN_OUT_TO=login

# ---------------------------------------------------------------------
# 9) เปิด/ปิดฟีเจอร์ — ใส่ true เพื่อเปิด ค่าอื่นหรือเว้นว่าง = ปิด
# EXPO_PUBLIC_ENABLE_SOCIAL_LOGIN: ปุ่ม Google / Facebook (เปิดหลังตั้ง provider ใน Supabase แล้ว)
#   ปิดอยู่ ปุ่มจะบอกว่ายังใช้ไม่ได้
# EXPO_PUBLIC_ENABLE_ACCOUNT_DELETION: เมนูลบบัญชี (เปิดเฉพาะ build ของ QA) · บัญชีที่นัดลบไว้แล้วยังเห็นเมนูเพื่อยกเลิก
# ---------------------------------------------------------------------
# EXPO_PUBLIC_ENABLE_SOCIAL_LOGIN=false
# EXPO_PUBLIC_ENABLE_ACCOUNT_DELETION=false
