# ⚡ NESTYK — Backend API (root `.env.api`)
# Copy: cp .env.api.example .env.api
# โหลดโดย apps/api เท่านั้น

NODE_ENV=development
PORT=4000

# Public signing links (web marketplace origin, no trailing slash)
PUBLIC_WEB_URL=http://localhost:3000

# 🗄️ PostgreSQL — same stack as Storage (local Supabase DB, mirrors hosted Supabase)
# Start: ./docs/new-project/docker/start-supabase-local.sh
# Then:  ./docs/new-project/docker/apply-schema.sh
# Deploy: swap to hosted pooler URL (still Supabase Postgres).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
DB_SCHEMA=public
# Optional: set true to print every SQL statement (noisy in turbo/dev terminals)
# TYPEORM_LOGGING=true

# 🔐 Supabase — API + Storage (local Docker via CLI; deploy = swap URL/keys to cloud)
# Keys from `npx supabase status` in this repo.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Local auth without real Supabase JWT (Bearer dev|<uuid>|<email>|…)
# Required for mobile DEV login against local API.
ALLOW_DEV_AUTH=true
# Dev grant/revoke roles via POST|DELETE /auth/dev/roles
ALLOW_DEV_ROLE_GRANT=true

# After schema apply, seed portable sample profile + agent demo + photos:
#   ./docs/new-project/docker/seed-dev-user.sh
#   ./docs/new-project/docker/seed-agent-demo.sh
#   ./docs/new-project/docker/seed-agent-photos.sh
# Login (mobile): admin@jitsamrit.com / Jitsamrit2026
# UUID: 00000000-0000-4000-8000-000000000001

# 📦 Storage Buckets
SUPABASE_BUCKET_PROPERTIES=property-images
SUPABASE_BUCKET_CONTRACTS=contracts

# Google Places (New) — server proxy for listing address autocomplete
GOOGLE_MAPS_API_KEY=

# Vertex AI (Gemini listing promo via @google/genai + service account)
VERTEX_PROJECT_ID=nestiq-500903
VERTEX_LOCATION=us-central1
# Path to GCP service-account JSON (absolute, or relative to monorepo root / .env.api)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-vertex-sa.json
# Hosts without a key file (Railway): put the file's content here instead, raw JSON or base64.
# Takes precedence over GOOGLE_APPLICATION_CREDENTIALS. Never commit a real value.
# GOOGLE_CREDENTIALS_JSON=
# Prefer Vertex model IDs (e.g. gemini-2.0-flash-001, gemini-2.5-flash)
GEMINI_MODEL=gemini-2.0-flash-001
# Local/demo without Vertex: deterministic listing promo (no Google call)
GEMINI_MOCK=false
# Optional comma-separated fallbacks
# GEMINI_FALLBACK_MODELS=gemini-2.0-flash-001,gemini-2.5-flash
# Circuit breaker: cooldown ms after repeated overloads (dev default 30s)
# GEMINI_CIRCUIT_COOLDOWN_MS=30000
# Set true to disable circuit entirely (local debugging only)
# GEMINI_CIRCUIT_DISABLED=false

# Claid AI — room photo enhance (POST /v1/image/edit). Leave blank until you have a key.
# Docs: https://docs.claid.ai/quick-start
CLAID_API_KEY=
# Optional override (default https://api.claid.ai)
CLAID_API_URL=https://api.claid.ai
# Dev/demo without Claid: local sharp enhance + upload (no external API)
CLAID_MOCK=true
