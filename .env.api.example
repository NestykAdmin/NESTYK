# =====================================================================
# NESTYK — Backend API (.env.api ที่ root)
# ไฟล์ตัวอย่าง (commit ได้): cp .env.api.example .env.api แล้วใส่ค่าที่ว่างหรือมี <...> ห้ามใส่ค่าจริงในไฟล์นี้
# ใช้โดย: apps/api ตอนรันบนเครื่อง และสคริปต์ db:push / db:seed / db:check
# - API บน Railway ไม่ได้อ่านไฟล์นี้ ค่าของ Railway อยู่ในหน้า Variables
# - มีคีย์ลับ ห้าม commit และห้ามแปะค่าในแชท
# - แก้แล้วต้อง restart API
# =====================================================================

# ---------------------------------------------------------------------
# 1) เซิร์ฟเวอร์
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------
# 2) ฐานข้อมูล
# ---------------------------------------------------------------------
# ชี้ Supabase dev ตัวจริง: db:push / db:seed จะรันกับฐานข้อมูลนี้ทันที (ใช้ -- --check ลองก่อน)
# ต้องเป็น Session pooler port 5432 / รหัสผ่านที่มี @ # / ? % ต้องแปลงเป็น %xx
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password-url-encoded>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_SCHEMA=public

# ---------------------------------------------------------------------
# 3) Supabase — Auth + Storage
# ---------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# คีย์ลับ: ข้ามการป้องกันทุกอย่างของ Supabase ใส่ได้เฉพาะไฟล์นี้
SUPABASE_SERVICE_ROLE_KEY=
# ชื่อ bucket ต้องตรงกับ Variables บน Railway ไม่อย่างนั้นไฟล์ที่ API แต่ละตัวอัปโหลดจะอยู่คนละที่
SUPABASE_BUCKET_PROPERTIES=property-images
SUPABASE_BUCKET_CONTRACTS=contract-documents

# ---------------------------------------------------------------------
# 4) ทางลัดสำหรับ dev
# ---------------------------------------------------------------------
# ALLOW_DEV_AUTH=true      รับ token ปลอม dev|uuid|email โดยไม่ตรวจกับ Supabase
# ALLOW_DEV_ROLE_GRANT=true ให้ผู้ใช้ขอสิทธิ์ admin ให้ตัวเองผ่าน /auth/dev/roles
# ฐานข้อมูลเป็น Supabase จริง ต้องเป็น false ทั้งคู่ เปิดเป็น true ได้เฉพาะตอนต่อ Supabase ใน docker บนเครื่อง
ALLOW_DEV_AUTH=false
ALLOW_DEV_ROLE_GRANT=false

# ---------------------------------------------------------------------
# 5) Google — Places (ค้นหาที่อยู่) และ Vertex AI (Gemini เขียนคำโปรโมท)
# ---------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
# บนเครื่อง: path ไฟล์ service account (เทียบจาก root) / บน Railway ใช้ GOOGLE_CREDENTIALS_JSON แทน
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-2.0-flash-001
# true = ไม่เรียก Google คืนข้อความตัวอย่าง
GEMINI_MOCK=false

# ---------------------------------------------------------------------
# 6) Claid — ปรับรูปห้องด้วย AI
# ---------------------------------------------------------------------
# ยังไม่มี key: ใช้ CLAID_MOCK=true (ปรับแสง/ความคมด้วย sharp บนเซิร์ฟเวอร์แทน)
CLAID_API_KEY=
CLAID_API_URL=https://api.claid.ai
CLAID_MOCK=true

# ---------------------------------------------------------------------
# 7) URL ของเว็บ — ใช้สร้างลิงก์แชร์ห้องและลิงก์เซ็นสัญญา
# ---------------------------------------------------------------------
# ⚠ ยังไม่ได้ใส่ — ตอนนี้ลิงก์จะเป็น http://localhost:3000 (ค่าเริ่มต้นในโค้ด) ใส่โดเมน Vercel เมื่อเว็บขึ้นแล้ว
# PUBLIC_WEB_URL=

# ---------------------------------------------------------------------
# 8) บัญชีทดสอบ (npm run db:test-users -w @nestyk/api) — dev เท่านั้น
# ---------------------------------------------------------------------
# สร้าง qa-guest / qa-tenant / qa-landlord / qa-owner / qa-agent / qa-admin @ โดเมนด้านล่าง ใช้รหัสผ่านเดียวกัน
# ห้ามตั้ง ALLOW_TEST_USERS=true ในไฟล์ที่ชี้ prod
# รหัสผ่านที่มี # ต้องครอบด้วย "..." ไม่อย่างนั้นส่วนหลัง # ถูกตัดทิ้ง
ALLOW_TEST_USERS=false
# ⚠ ยังไม่ได้ใส่ — อย่างน้อย 8 ตัวอักษร
TEST_USER_PASSWORD=
# โดเมนต้องมีจุด เพราะ API ตรวจรูปแบบอีเมลแบบมีจุด (.test เป็นโดเมนสำหรับทดสอบ ส่งเมลไม่ได้จริง)
TEST_USER_EMAIL_DOMAIN=nestyk.test

# ---------------------------------------------------------------------
# 9) ตัวเลือกเสริม — ไม่ใส่ก็ได้ โค้ดใช้ค่าเริ่มต้น
# ---------------------------------------------------------------------
# true = พิมพ์ SQL ทุกคำสั่ง (log จะเยอะมาก)
# TYPEORM_LOGGING=true
# รุ่น Gemini สำรองเมื่อรุ่นหลักใช้ไม่ได้ คั่นด้วย ,
# GEMINI_FALLBACK_MODELS=gemini-2.0-flash-001,gemini-2.5-flash
# หยุดเรียก Gemini ชั่วคราว (ms) หลังล้มหลายครั้งติดกัน / true = ปิดตัวหยุดนี้ (ใช้ตอน debug เท่านั้น)
# GEMINI_CIRCUIT_COOLDOWN_MS=30000
# GEMINI_CIRCUIT_DISABLED=false
# ใช้บน Railway แทน GOOGLE_APPLICATION_CREDENTIALS (ใส่เนื้อหาไฟล์ service account แบบ JSON หรือ base64) บนเครื่องไม่ต้องใส่
# GOOGLE_CREDENTIALS_JSON=
