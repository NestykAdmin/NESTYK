{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build -w @nestyk/api",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/types/**",
      "/packages/config/**",
      "/supabase/migrations/**",
      "/package.json",
      "/package-lock.json",
      "/railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": ["node apps/api/scripts/db-push.cjs"],
    "startCommand": "cd apps/api && NODE_ENV=production node dist/main",
    "healthcheckPath": "/api/v1/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
